// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  // temporarily nullable
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
  emailVerified DateTime?
  files        File[]
  fileShares   FileShare[] // shares granted TO this user
}

enum FileStatus {
  // Row exists, but the client has not confirmed the S3 upload yet.
  PENDING
  // Object verified present in S3; `size` is its true ContentLength.
  READY
}

model File {
  id        String     @id @default(uuid())
  filename  String
  mimeType  String
  // Client-claimed at upload-url time, overwritten with the object's real
  // ContentLength once the upload is confirmed.
  size      Int
  s3Key     String     @unique
  status    FileStatus @default(PENDING)
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt @default(now())

  shares    FileShare[]
  shareLink ShareLink?

  @@index([ownerId, status])
}

model FileShare {
  id        String   @id @default(uuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fileId, userId]) // one grant per pair; also the "am I shared this" lookup index
  @@index([userId])          // for listSharedWithMe
}

model ShareLink {
  id        String   @id @default(uuid())
  fileId    String   @unique // DB-level guarantee of "one active link per file"
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())
}
