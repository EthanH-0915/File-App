NEXT_PUBLIC_API_URL=http://localhost:3001

# Max upload size in bytes, checked in the browser before an upload URL is
# requested. Must not exceed the backend's MAX_UPLOAD_SIZE_BYTES
# (backend/src/files/constants.ts), which is the real enforcement.
# Defaults to 10MB when unset.
NEXT_PUBLIC_UPLOAD_MAX_SIZE=10485760
